# Copy to .env and fill in. .env stays on the server: it's in .gitignore.

# Where recordings and snapshots go. Plan on a few hundred GB (docs/frigate.md).
STORAGE_PATH=/srv/frigate

# The folder holding config.yml. Leave it out with the docker compose command
# (it uses ./config next to docker-compose.yml). Portainer needs a full path.
CONFIG_PATH=/srv/frigate-config

# UniFi Protect console (UDM, UNVR, Cloud Key...).
FRIGATE_PROTECT_HOST=192.168.1.1

# RTSP stream ids from Protect: open each camera's Settings > Advanced >
# RTSP, turn on High and Medium, and copy the part after the last "/" of each
# address, without "?enableSrtp". High is recorded; Medium is what Frigate
# looks for hens in.
FRIGATE_CAM1_HIGH=
FRIGATE_CAM1_MEDIUM=
FRIGATE_CAM2_HIGH=
FRIGATE_CAM2_MEDIUM=
FRIGATE_RUN_HIGH=
FRIGATE_RUN_MEDIUM=

# Home Assistant's MQTT broker (the Mosquitto add-on on the Yellow).
FRIGATE_MQTT_HOST=homeassistant.local
FRIGATE_MQTT_USER=frigate
FRIGATE_MQTT_PASSWORD=
